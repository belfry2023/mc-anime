# ============================================================
# Minecraft 整合包 .gitignore
# 本仓库只保留「核心配置 / 脚本 / 文档」，不传运行时与大体积文件。
# ============================================================

# ---------- 通用垃圾（任意目录） ----------
__pycache__/
*.py[cod]
*.class
*.log
*.err
hs_err_pid*
*.tmp
*.temp
~$*
.DS_Store
Thumbs.db
desktop.ini

# ---------- .minecraft 运行时与大体积目录 ----------
game/.minecraft/mods/
game/.minecraft/mods-disabled/
game/.minecraft/saves/
game/.minecraft/libraries/
game/.minecraft/assets/
game/.minecraft/natives/
game/.minecraft/versions/
game/.minecraft/.lwjgl/
game/.minecraft/logs/
game/.minecraft/crash-reports/
game/.minecraft/backups/
game/.minecraft/local/
game/.minecraft/tacz/
game/.minecraft/tlm_custom_pack/
game/.minecraft/defaultconfigs/
game/.minecraft/resourcepacks/
game/.minecraft/patchouli_books/
game/.minecraft/screenshots/
game/.minecraft/shaderpacks/
game/.minecraft/blueprints/
game/.minecraft/schematics/
game/.minecraft/config/touhou_little_maid/file/

# ---------- config 内的缓存 / 内置模型 / 资源包（可整目录重建） ----------
game/.minecraft/config/yes_steve_model/builtin/
game/.minecraft/config/yes_steve_model/cache/
game/.minecraft/config/ysm_geo_compat/resourcepack/
game/.minecraft/config/**/cache/
game/.minecraft/config/**/builtin/
game/.minecraft/config/**/resourcepack/

# ---------- PCL2 启动器与 native 二进制（不传） ----------
/game/JavaWrapper.jar
/game/PCL2启动器.exe
/game/Setup.ini
/game/libjlw-x86_64-1.4.4.dll
/game/libwebp.dll
game/.minecraft/config/epicfight/native/

# ---------- 敏感身份文件（不传） ----------
game/.minecraft/identity.json
game/.minecraft/usernamecache.json
game/.minecraft/usercache.json
game/.minecraft/launcher_profiles.json
game/.minecraft/options.txt
game/.minecraft/options.txt.bak
game/.minecraft/launch-args.txt
game/.minecraft/launch-err.log
game/.minecraft/launch-out.log
game/.minecraft/rhino.local.properties
game/.minecraft/patchouli_data.json
game/.minecraft/forge-1.20.1-47.4.29-installer.jar.log
game/.minecraft/rimulib.log
game/.minecraft/shooting_star.log

# ---------- 房子导出数据（游戏里 /savehome go 生成，体积大且经常变，不进仓库） ----------
game/.minecraft/kubejs/home_saved.json
game/.minecraft/kubejs/server_scripts/home_saved_data.js

# ---------- 备份文件（*.bak 一律忽略，但保留 kubejs 归档脚本） ----------
*.bak
!game/.minecraft/kubejs/_archived_scripts/*.bak

# ---------- 测试服务器 / JDK / 临时目录 ----------
jdk/
server-test*/
tmp/
tmp_is/
tmp_maidspell/

# ---------- 根目录截图 / 安装包 / 日志 / 临时调试残留 ----------
/screenshot*.png
/shot-*.png
/forge-1.20.1-47.4.29-installer.jar
/server-run*.log
/server-run*.err
/launch-test*.ps1
/tmp_*.py
/tmp_*.json
/tmp_*.dat
/scan_blocks.py

# ---------- �浵������ mod ����ʱ���ݣ�����󣬲����ֿ⣩ ----------
backups/
game/.minecraft/millenaire/
game/.minecraft/millenaire-custom/

# ---------- 分发产物（tools\build-dist.ps1 生成，体积大，不入库） ----------
/dist/

# playit ������͸�ͻ��ˣ�����ר�ã�����⣩
tools/playit/*.exe
# ---------- 运行时状态（服务器列表 / 模型白名单） ----------
game/.minecraft/servers.dat
game/.minecraft/servers.dat_old
game/.minecraft/sexmod/custom_models/
# ---------- 下载的安装器（体积大，不入库） ----------
tools/联机-Tailscale/tailscale-setup*.exe
