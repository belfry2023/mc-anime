const MK_AMMO = ['12g','22wmr','300blk','308','30_06','338','357mag','40mm','45acp','45_70','46x30','500mag','50ae','50bmg','545x39','556x45','57x28','58x42','68x51fury','762x25','762x39','762x54','792x57','9mm','rpg_rocket']

// 把一堆 {id, tag, count} 序列化成箱子的 Items NBT
function mkChestItems(stacks) {
  const parts = stacks.map((s, i) =>
    '{Slot:' + i + 'b,id:"' + s.id + '",Count:' + s.count + 'b' + (s.tag ? ',tag:' + s.tag : '') + '}')
  return '{Items:[' + parts.join(',') + ']}'
}

function mkArmoryStacks() {
  const stacks = []
  MK_GUNS.forEach(g => stacks.push({ id: 'tacz:modern_kinetic_gun', tag: '{GunId:"tacz:' + g + '"}', count: 1 }))
  MK_ATTACH.forEach(a => stacks.push({ id: 'tacz:attachment', tag: '{AttachmentId:"tacz:' + a + '"}', count: 10 }))
  MK_MAID_ITEMS.forEach(([id, count]) => stacks.push({ id: id, count: count }))
  MK_AMMO.forEach(a => {
    let left = 2000
    while (left > 0) {
      const c = Math.min(64, left)
      stacks.push({ id: 'tacz:ammo', tag: '{AmmoId:"tacz:' + a + '"}', count: c })
      left -= c
    }
  })
  return stacks
}

function buildHome(server, p) {
  const px = Math.floor(p.x)
  const py = Math.floor(p.y)
  const pz = Math.floor(p.z)
  const cy = py + 9          // 庭院地面
  const base = py + 10       // 一层地板
  const x0 = px - 6
  const z0 = pz - 4
  const x1 = x0 + 12
  const z1 = z0 + 8
  const run = (c) => server.runCommandSilent(c)

  // 山体
  run(`fill ${px - 10} ${py} ${pz - 10} ${px + 10} ${py + 8} ${pz + 10} minecraft:stone`)
  run(`fill ${px - 10} ${py + 8} ${pz - 10} ${px + 10} ${py + 8} ${pz + 10} minecraft:moss_block`)
  // 庭院地面与围墙
  run(`fill ${px - 10} ${cy} ${pz - 10} ${px + 10} ${cy} ${pz + 10} minecraft:stone_bricks`)
  run(`fill ${px - 10} ${cy + 1} ${pz - 10} ${px + 10} ${cy + 1} ${pz - 10} minecraft:stone_brick_wall`)
  run(`fill ${px - 10} ${cy + 1} ${pz + 10} ${px + 10} ${cy + 1} ${pz + 10} minecraft:stone_brick_wall`)
  run(`fill ${px - 10} ${cy + 1} ${pz - 10} ${px - 10} ${cy + 1} ${pz + 10} minecraft:stone_brick_wall`)
  run(`fill ${px + 10} ${cy + 1} ${pz - 10} ${px + 10} ${cy + 1} ${pz + 10} minecraft:stone_brick_wall`)
  run(`fill ${px - 1} ${cy + 1} ${pz + 10} ${px + 1} ${cy + 1} ${pz + 10} minecraft:air`)

  // 主体：一层
  run(`fill ${x0} ${base} ${z0} ${x1} ${base + 5} ${z1} minecraft:white_concrete hollow`)
  run(`fill ${x0} ${base - 1} ${z0} ${x1} ${base - 1} ${z1} minecraft:smooth_quartz`)
  run(`fill ${x0 + 1} ${base} ${z0} ${x1 - 1} ${base + 4} ${z1 - 1} minecraft:air`)
  run(`fill ${x0} ${base + 5} ${z0} ${x1} ${base + 5} ${z1} minecraft:smooth_quartz`)
  // 门与窗
  run(`fill ${px} ${base} ${z1} ${px} ${base + 1} ${z1} minecraft:air`)
  run(`fill ${x0 + 2} ${base + 2} ${z0} ${x0 + 6} ${base + 3} ${z0} minecraft:glass`)
  run(`fill ${x0} ${base + 2} ${z0 + 3} ${x0} ${base + 3} ${z0 + 5} minecraft:glass`)
  run(`fill ${x1} ${base + 2} ${z0 + 3} ${x1} ${base + 3} ${z0 + 5} minecraft:glass`)

  // 二层
  run(`fill ${x0} ${base + 6} ${z0} ${x1} ${base + 11} ${z1} minecraft:white_concrete hollow`)
  run(`fill ${x0 + 1} ${base + 6} ${z0} ${x1 - 1} ${base + 10} ${z1 - 1} minecraft:air`)
  run(`fill ${x0} ${base + 11} ${z0} ${x1} ${base + 11} ${z1} minecraft:smooth_quartz`)
  run(`fill ${x0 + 2} ${base + 7} ${z0} ${x1 - 2} ${base + 9} ${z0} minecraft:glass`)
  run(`fill ${x0 + 2} ${base + 7} ${z1} ${x1 - 2} ${base + 9} ${z1} minecraft:glass`)
  // 屋顶与露台
  run(`fill ${x0 - 1} ${base + 12} ${z0 - 1} ${x1 + 1} ${base + 12} ${z1 + 1} minecraft:smooth_quartz_slab`)
  run(`fill ${x0 + 2} ${base + 6} ${z1 + 1} ${x1 - 2} ${base + 6} ${z1 + 3} minecraft:smooth_quartz_slab`)
  run(`fill ${x0 + 2} ${base + 7} ${z1 + 3} ${x1 - 2} ${base + 7} ${z1 + 3} minecraft:oak_fence`)

  // 楼梯（一层到二层）
  for (let i = 0; i < 6; i++) {
    run(`setblock ${x1 - 1} ${base + i} ${z1 - 1 - i} minecraft:smooth_quartz_stairs[facing=east,half=bottom]`)
  }

  // 床与灯
  run(`setblock ${x0 + 1} ${base} ${z0 + 1} minecraft:red_bed[part=foot,facing=south]`)
  run(`setblock ${x0 + 1} ${base} ${z0 + 2} minecraft:red_bed[part=head,facing=south]`)
  run(`setblock ${x0 + 1} ${base + 4} ${z0 + 1} minecraft:lantern`)
  run(`setblock ${x1 - 1} ${base + 4} ${z1 - 2} minecraft:lantern`)
  run(`setblock ${x0 + 1} ${base + 10} ${z0 + 1} minecraft:lantern`)

  // 庭院水池
  run(`fill ${px - 2} ${cy} ${pz - 2} ${px + 2} ${cy} ${pz + 2} minecraft:smooth_quartz_slab`)
  run(`fill ${px - 1} ${cy} ${pz - 1} ${px + 1} ${cy} ${pz + 1} minecraft:water`)
  // 树
  for (const t of [[px - 8, pz - 8], [px + 8, pz - 8], [px - 8, pz + 8], [px + 8, pz + 8]]) {
    run(`fill ${t[0]} ${cy + 1} ${t[1]} ${t[0]} ${cy + 4} ${t[1]} minecraft:oak_log`)
    run(`fill ${t[0] - 1} ${cy + 5} ${t[1] - 1} ${t[0] + 1} ${cy + 6} ${t[1] + 1} minecraft:oak_leaves`)
  }

  // 军械库：庭院东边单独一间，门口铺路，箱子三排留两格过道
  const ax0 = px + 18
  const az0 = pz - 6
  const ax1 = ax0 + 18
  const az1 = az0 + 12
  run(`fill ${ax0} ${cy} ${az0} ${ax1} ${cy} ${az1} minecraft:stone_bricks`)
  run(`fill ${ax0} ${cy + 1} ${az0} ${ax1} ${cy + 5} ${az1} minecraft:stone_bricks hollow`)
  run(`fill ${ax0 + 1} ${cy + 1} ${az0 + 1} ${ax1 - 1} ${cy + 5} ${az1 - 1} minecraft:air`)
  run(`fill ${ax0 + 1} ${cy + 5} ${az0 + 1} ${ax1 - 1} ${cy + 5} ${az1 - 1} minecraft:stone_brick_slab`)
  // 西墙开三格宽的门
  run(`fill ${ax0} ${cy + 1} ${pz - 1} ${ax0} ${cy + 3} ${pz + 1} minecraft:air`)
  // 从别墅门口一路铺到军械库门口，顺手在院墙上开个豁口
  run(`fill ${px + 6} ${cy} ${pz - 1} ${ax0 - 1} ${cy} ${pz + 1} minecraft:smooth_quartz`)
  run(`fill ${px + 10} ${cy + 1} ${pz - 1} ${px + 10} ${cy + 3} ${pz + 1} minecraft:air`)
  run(`setblock ${ax0 + 1} ${cy + 4} ${az0 + 1} minecraft:lantern`)
  run(`setblock ${ax1 - 1} ${cy + 4} ${az1 - 1} minecraft:lantern`)
  run(`setblock ${ax0 + 3} ${cy + 4} ${az0 + 1} minecraft:lantern`)

  const stacks = mkArmoryStacks()
  const chests = []
  // 每排 14 只 = 7 个大箱子，正好两两成对，不留单只
  for (let r = 0; r < 3; r++) {
    for (let c = 0; c < 14; c++) chests.push([ax0 + 3 + c, cy + 1, az0 + 2 + r * 4])
  }
  let idx = 0
  chests.forEach(pos => {
    const chunk = stacks.slice(idx, idx + 27)
    idx += 27
    if (chunk.length === 0) {
      run(`setblock ${pos[0]} ${pos[1]} ${pos[2]} minecraft:chest replace`)
      return
    }
    run(`setblock ${pos[0]} ${pos[1]} ${pos[2]} minecraft:chest${mkChestItems(chunk)} replace`)
  })

  // 家与出生点
  run(`setworldspawn ${px} ${base + 1} ${pz}`)
  run(`tp ${p.username} ${px} ${base + 1} ${pz}`)
  run(`effect give ${p.username} minecraft:instant_health 1 4 true`)
  server.tell(`§b山顶那栋房子建好了，床在门口左手边。军械库是庭院东边那间石砖屋，门口有一条石板路：${MK_GUNS.length} 把枪、${MK_ATTACH.length} 种配件各 10、${MK_AMMO.length} 种子弹各 2000。`)
  server.tell(`§7出生点已设在这里，摔下去别怪我没提醒。`)
}

PlayerEvents.loggedIn(event => {
  const p = event.player
  if (p.persistentData.contains('mk_home')) return

  // 只在新世界里自动建（世界时间还不到 10 秒），免得把老存档的家埋了
  const gt = run(event.server, 'time query gametime')
  if (gt < 200) {
    p.persistentData.putString('mk_home', 'on')
    buildHome(event.server, p)
  } else {
    p.tell('§7这个存档已经有年头了。想要开局别墅：Esc → 对局域网开放 → 允许作弊，然后敲 /mkhome；或者干脆开个新世界。')
  }
})

ServerEvents.commandRegistry(event => {
  const { commands: Commands } = event
  event.register(Commands.literal('mkhome').executes(ctx => {
    const player = ctx.source.player
    if (!player) return 0
    buildHome(ctx.source.server, player)
    return 1
  }))
})
